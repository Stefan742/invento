# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (docker compose up -d gives you this one locally)
DATABASE_URI=postgres://invento:invento@127.0.0.1:5433/invento

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Absolute public URL of the site (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin user created by `pnpm seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Show seeded sample content marked isPlaceholder (true in dev, MUST be false in production)
SHOW_PLACEHOLDERS=true

# Owner notification address for new orders (M3)
ORDER_NOTIFY_EMAIL=

# Email provider (M3). Leave empty in dev: emails are logged to the console instead.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=INVENTO

# Optional Cloudflare Turnstile (spam protection on the order form, M3)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# S3-compatible media storage for production (e.g. Cloudflare R2), decided at M6
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
