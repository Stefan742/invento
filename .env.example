# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (docker compose up -d gives you this one locally)
DATABASE_URI=postgres://invento:invento@127.0.0.1:5433/invento

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Absolute public URL of the site (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin user created by `pnpm seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Show seeded sample content marked isPlaceholder (true in dev, MUST be false in production)
SHOW_PLACEHOLDERS=true

# Inbox for new-order and contact-form emails
ORDER_NOTIFY_EMAIL=

# Order requests allowed per IP per 10 minutes
ORDER_RATE_LIMIT=5

# Email via Resend. Leave empty in dev: emails are printed to the console instead.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=INVENTO

# Optional Cloudflare Turnstile (extra spam protection on the order form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional cookieless analytics (off when empty). See docs/ANALYTICS.md
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_SRC=

# Switch motion features off at build time: all, or e.g. preloader,physics
NEXT_PUBLIC_MOTION_OFF=

# S3-compatible media storage for production (Cloudflare R2). Leave S3_BUCKET empty to keep
# uploads on local disk (/media). R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
